{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'DASLAB_TOOL_ALLOWLIST=\"$CLAUDE_PROJECT_DIR/board/.tool-allowlist.json\" python3 \"$CLAUDE_PROJECT_DIR/tools/mcp_bridges/audit_external_tool.py\" || exit 2'"
          }
        ]
      }
    ]
  }
}
